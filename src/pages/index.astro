---
const name = "Gulnara Tanbayeva";
const email = "gulnaratanbayeva@gmail.com";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/G.svg" />
		<title>{name} | Portfolio</title>
		<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;700&family=Playfair+Display:ital,wght@1,700&display=swap" rel="stylesheet">
	</head>
	<body>
		<main class="hero">
			<div class="container">
				<div class="left-side">
					<div class="image-wrapper">
						<img src="/my.jpg" alt={name} />
					</div>
				</div>

				<div class="right-side">
					<nav class="top-nav">
						<a href="/experience">Experience</a>
						<a href="/about">About</a>
					</nav>

					<div class="content">
						<span class="greeting">Hello! I am </span>
						<h1>{name}</h1>
						
						<p class="subtitle">
							Specializing in <strong>Project Management</strong> & <strong>Analytics</strong>
						</p>

						<div class="contact-grid">
							<div class="contact-item">
								<span class="label">Email</span>
								<a href={`mailto:${email}`} class="link">{email}</a>
							</div>
							<div class="contact-item">
								<span class="label">Location</span>
								<span class="val">Astana, Kazakhstan</span>
							</div>
						</div>

						<div class="links">
							<a target="_blank" href="https://t.me/gulnaratanbayeva" class="btn-main">Contact via Telegram</a>
							<div class="social-wrapper">
								<a target="_blank" href="https://www.linkedin.com/in/gulnaratanbayeva/">LinkedIn</a>
								<a target="_blank" href="https://github.com/GulnaraTanbayeva">GitHub</a>
							</div>
						</div>
					</div>
				</div>
			</div>
		</main>

		<style>
			:root {
				--bg-dark: #1a1a1a;
				--card-bg: #242424; /* Slightly lighter than background for depth */
				--accent-pink: #fbcfe8;
				--deep-pink: #db2777;
				--text-main: #ffffff;
				--text-muted: #aaa;
			}

			body { 
				margin: 0; 
				font-family: 'Montserrat', sans-serif; 
				background-color: var(--bg-dark); 
				color: var(--text-main); 
			}

			.hero { 
				display: flex; 
				align-items: center; 
				justify-content: center; 
				min-height: 100vh;
				padding: 40px; 
				box-sizing: border-box;
			}

			.container { 
				display: flex; 
				width: 100%; 
				max-width: 1100px; 
				height: 75vh; 
				background: var(--card-bg); 
				border-radius: 40px; 
				box-shadow: 0 40px 100px rgba(0,0,0,0.5); 
				overflow: hidden; 
				border: 1px solid rgba(251, 207, 232, 0.1);
			}

			.left-side { 
				flex: 1; 
				background: #000; 
			}

			.image-wrapper {
				width: 100%;
				height: 100%;
			}

			.image-wrapper img { 
				width: 100%; 
				height: 100%; 
				object-fit: cover; 
				opacity: 0.9;
			}

			.right-side { 
				flex: 1.2; 
				padding: 60px; 
				display: flex; 
				flex-direction: column; 
				justify-content: center;
			}

			.top-nav { 
				display: flex; 
				gap: 30px; 
				justify-content: flex-end; 
				right: 60px;
				margin-bottom: 60px;
			}

			.top-nav a { 
				text-decoration: underline; 
				color: var(--text-muted); 
				font-weight: 700; 
				font-size: 0.8rem; 
				letter-spacing: 2px;
				text-transform: uppercase;
				transition: 0.3s; 
				font-style: italic;
			}

			.top-nav a:hover { color: var(--accent-pink); }
			
			h1 { 
				font-family: 'Playfair Display', serif; 
				font-size: 3.5rem; 
				margin: 10px 0; 
				font-style: italic;
			}

			.greeting { 
				color: var(--accent-pink); 
				font-weight: 700; 
				letter-spacing: 3px; 
				text-transform: uppercase; 
				font-size: 0.8rem; 
			}

			.subtitle { 
				font-size: 1.1rem; 
				margin-bottom: 30px; 
				color: var(--text-muted);
			}

			.subtitle strong {
				color: var(--accent-pink);
				font-weight: 400;
			}

			.contact-grid { 
				display: grid; 
				grid-template-columns: 1fr 1fr; 
				gap: 20px; 
				margin-bottom: 40px; 
				border-top: 1px solid rgba(255,255,255,0.05); 
				padding-top: 30px; 
			}

			.label { 
				display: block; 
				font-size: 0.65rem; 
				text-transform: uppercase; 
				color: #666; 
				font-weight: 700; 
				margin-bottom: 5px; 
				letter-spacing: 2px;
			}

			.link { color: var(--text-main); text-decoration: none; font-weight: 600; transition: 0.3s; }
			.link:hover { color: var(--accent-pink); }
			.val { font-weight: 600; color: var(--text-main); }

			.links { 
				display: flex; 
				align-items: center; 
				gap: 30px; 
			}

			.social-wrapper {
				display: flex;
				gap: 20px;
			}

			.social-wrapper a { 
				color: var(--text-muted); 
				text-decoration: none; 
				font-size: 0.75rem; 
				font-weight: 700;
				letter-spacing: 1px;
				transition: 0.3s;
			}

			.social-wrapper a:hover { color: var(--accent-pink); }

			.btn-main { 
				background: white; 
				color: #1a1a1a; 
				padding: 14px 28px; 
				border-radius: 4px; 
				text-decoration: none; 
				font-weight: 700; 
				font-size: 0.8rem;
				letter-spacing: 1px;
				transition: 0.3s; 
			}

			.btn-main:hover { 
				background: var(--accent-pink);
				transform: translateY(-2px); 
			}

			@media (max-width: 900px) { 
				.container { flex-direction: column; height: auto; border-radius: 20px; } 
				.left-side { height: 400px; } 
				.right-side { padding: 40px 30px; }
				.top-nav { position: relative; top: 0; right: 0; margin-bottom: 40px; justify-content: center; }
				.links { flex-direction: column; align-items: center; } 
				h1 { font-size: 2.5rem; text-align: center; }
				.greeting { text-align: center; display: block; }
				.subtitle { text-align: center; }
				.contact-grid { text-align: center;
        display: flex;
        flex-direction: column; }
			}
		</style>
	</body>
</html>