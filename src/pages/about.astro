---
const name = "Gulnara Tanbayeva";
const portfolioLink = "https://gulnaratanbayeva.notion.site/Gulnara-Tanbayeva-214ae3e92a7780b29142f48566e62569?pvs=143";
const resumeLink = "https://drive.google.com/file/d/1YChNFncufHpO71P0xXjulcIIdtFbpEvt/view?usp=sharing";
---

<html lang="en">
	<head>
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta charset="utf-8" />
		<title>About | {name}</title>
		<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;700&family=Playfair+Display:ital,wght@1,700&display=swap" rel="stylesheet">
	</head>
	<body>
		<nav class="top-nav">
			<a href="/" class="interactive-el">← HOME</a>
			<div class="links interactive-el"> 
				<a href={portfolioLink} target="_blank" class="drive-cta">Portfolio ↗</a>
				<a href={resumeLink} target="_blank" class="drive-cta">CV ↗</a>
			</div>
		</nav>

		<main class="about-container">
			<header class="hero-header">
				<span class="mode-tag">PERSONAL MODE</span>
				<h1>Beyond the Screen</h1>
			</header>

			<section class="content-slice alternate">
				<div class="side-label">ENDURANCE</div>
				<div class="details">
					<span class="section-number">01</span>
					<h2>21KM & Counting</h2>
					<p class="desc">
						Running is my meditation. Currently training for my next half-marathon, I focus on the discipline of the long-distance grind. I am a consistent finisher of <strong>charity marathons</strong>.
					</p>
				</div>
				<div class="image-proof">
					<img src="/run.jpg" alt="Marathon Proof" />
				</div>
			</section>

			<section class="content-slice">
				<div class="side-label">IMPACT</div>
				<div class="details">
					<span class="section-number">02</span>
					<h2>BF Mereke</h2>
					<p class="desc">
						Deeply committed to social welfare in Astana. Organizing food drives and school kits with <strong>BF Mereke</strong> is about direct, tangible community support.
					</p>
				</div>
				<div class="image-proof">
					<img src="/volunteer.jpg" alt="Volunteering Proof" />
				</div>
			</section>

			<section class="content-slice alternate">
				<div class="side-label">CULTURE</div>
				<div class="details">
					<span class="section-number">03</span>
					<h2>Linguistic & Global</h2>
					<div class="stats-grid">
						<div class="stat-box">
							<h3>Languages</h3>
							<p>Kazakh • Russian • English (7.5) • Turkish(A2)</p>
						</div>
						<div class="stat-box">
							<h3>Conferences</h3>
							<p>International research delegations and tech summits in Germany and Kazakhstan.</p>
						</div>
					</div>
				</div>
				<div class="image-proof">
					<img src="/conference.jpg" alt="Conference Proof" />
				</div>
			</section>

			<section class="content-slice">
				<div class="side-label">INTELLECT</div>
				<div class="details">
					<span class="section-number">04</span>
					<h2>The Art of Argument</h2>
					<p class="desc">
						As an ex <strong>Debate Club Member</strong>, I spend my time dissecting complex global issues and honing the art of persuasion.
					</p>
				</div>
				<div class="image-proof">
					<img src="/debate.png" alt="Debate Proof" />
				</div>
			</section>

			<footer class="about-footer">
				<h2 class="footer-title">Let's start an <br/><i>Odyssey.</i></h2>
				<div class="social-links">
					<a href="mailto:gulnaratanbayeva@gmail.com">EMAIL</a>
					<a href="https://www.linkedin.com/in/gulnaratanbayeva/" target="_blank">LINKEDIN</a>
					<a href="https://telegram.me/gulnaratanbayeva" target="_blank">TELEGRAM</a>
				</div>
			</footer>
		</main>

		<style>
			:root {
				--accent-pink: #fbcfe8;
				--deep-pink: #db2777;
			}

			body { 
				margin: 0; 
				font-family: 'Montserrat', sans-serif; 
				background-color: #1a1a1a;
				color: white; 
				overflow-x: hidden;
			}

			.top-nav {
				position: fixed;
				top: 0; left: 0;
				width: 100%;
				padding: 30px 60px;
				display: flex;
				justify-content: space-between;
				align-items: center;
				z-index: 100;
				background: linear-gradient(to bottom, rgba(0,0,0,0.9), transparent);
				box-sizing: border-box; 
				pointer-events: none;
			}
			.interactive-el { pointer-events: auto; }
			.top-nav a { color: var(--accent-pink); text-decoration: none; font-weight: 700; font-size: 0.8rem; letter-spacing: 2px; }
			.links { display: flex; gap: 15px; }
			.drive-cta { border: 1px solid var(--accent-pink); padding: 8px 20px; border-radius: 5px; transition: 0.3s; }
			.drive-cta:hover { background: var(--accent-pink); color: #1a1a1a; }

			.about-container { padding-top: 150px; max-width: 1200px; margin: 0 auto; }

			.hero-header { text-align: center; margin-bottom: 120px; }
			.mode-tag { color: var(--accent-pink); letter-spacing: 5px; font-size: 0.7rem; font-weight: 700; }
			h1 { font-family: 'Playfair Display', serif; font-size: 5vw; font-style: italic; margin-top: 20px; }

			.content-slice { 
				display: flex; 
				margin-bottom: 150px; 
				padding: 0 50px;
				gap: 60px;
				align-items: center;
			}
			.content-slice.alternate { flex-direction: row-reverse; text-align: right; }

			.side-label { 
				font-size: 0.7rem; 
				font-weight: 700; 
				color: var(--accent-pink); 
				letter-spacing: 5px; 
				writing-mode: vertical-rl; 
				text-transform: uppercase;
				opacity: 0.4;
			}
			.content-slice.alternate .side-label { writing-mode: vertical-lr; transform: rotate(180deg); }

			.details { flex: 1.2; }
			.image-proof { flex: 1; overflow: hidden; border-radius: 10px; height: 400px; background: #222; }
			.image-proof img { width: 100%; height: 100%; object-fit: cover; filter: grayscale(40%) contrast(1.1); transition: 0.5s; }
			.image-proof:hover img { filter: grayscale(0%); transform: scale(1.05); }

			.section-number { font-family: 'Playfair Display', serif; font-size: 1.2rem; color: var(--accent-pink); opacity: 0.5; font-style: italic; }
			h2 { font-family: 'Playfair Display', serif; font-size: clamp(2rem, 4vw, 3.5rem); margin: 10px 0 20px; font-weight: 700; color: var(--accent-pink); }
			.desc { color: #bdbdbd; line-height: 1.8; font-size: 1.1rem; }

			.about-footer { text-align: center; padding: 100px 0; }
			.footer-title { font-family: 'Playfair Display', serif; font-size: clamp(2.5rem, 6vw, 4rem); margin-bottom: 60px; font-weight: 400; }
			.social-links { display: flex; justify-content: center; gap: 40px; }
			.social-links a { color: var(--accent-pink); text-decoration: none; font-weight: 700; font-size: 0.8rem; letter-spacing: 2px; }

			/* MOBILE FIXES */
			@media (max-width: 1024px) {
				.content-slice { flex-direction: column !important; gap: 30px; padding: 0 25px; text-align: left !important; }
				.image-proof { width: 100%; height: 300px; order: -1; } /* Image moves above text on mobile */
				.side-label { writing-mode: horizontal-tb !important; transform: none !important; margin-bottom: 5px; opacity: 0.6; }
				.desc { margin-left: 0 !important; }
				.social-links { flex-wrap: wrap; gap: 20px; }
				h1 { font-size: 2.5rem; }
				.top-nav {
        padding: 20px;
    }
    
    .top-nav a { font-size: 0.65rem; }
			}
		</style>
	</body>
</html>