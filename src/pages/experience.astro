---
const name = "Gulnara Tanbayeva";
const portfolioLink =
  "https://gulnaratanbayeva.notion.site/Gulnara-Tanbayeva-214ae3e92a7780b29142f48566e62569?pvs=143";
const resumeLink =
  "https://docs.google.com/document/d/1IrupD6AWzK_47Z9pmybdQ0ZlsaukpJBejXOLXan2kog/edit?usp=sharing";

const projects = [
  {
    year: "2026",
    period: "Nov 2026 – Present",
    title: "IT PROJECT LEAD AT AI-TANYM",
    role: "IT Project Lead",
    description:
      "Promoted to lead AI Tanym with full ownership of sales and the product team. I manage a UI/UX designer, a developer and the technical support team, and personally drive revenue: B2B partnerships with schools, B2C sales to parents, targeted ad campaigns and lead handling. Led the November 2026 platform launch and track the full funnel, from registrations to paid conversion, in Amplitude.",
    tech: "Sales & Partnerships • Team Leadership • Go-to-Market • Analytics",
    link: "https://aitanym.kz/",
  },
  {
    year: "2026",
    period: "Jun 2026 – Nov 2026",
    title: "PRODUCT MANAGER AT BI EDUCATION",
    role: "Product Manager",
    description:
      "Coordinated AI Tanym's educational content and video lesson production, analyzed user behavior, registrations, traffic and purchase conversion in Amplitude, ran user research and interviews, and supported product decisions with data and cross-functional teamwork.",
    tech: "Product Management • Analytics • Content Production • User Research",
    link: "https://aitanym.kz/",
  },
  {
    year: "2026",
    period: "Jan 2026 – Jun 2026",
    title: "PRODUCT INTERN AT BI EDUCATION",
    role: "Product Manager Intern",
    description:
      "Conducted research and interviews in the education field for AI Tanym, tested product features, reported bugs and suggested improvements, and visualized data with the Manim library.",
    tech: "User Research • QA • Data Visualization",
    link: "https://aitanym.kz/",
  },
  {
    year: "2024",
    period: "Dec 2024 – Present",
    title: "AGRIFUNDING",
    role: "Product Manager · Part-time",
    description:
      "Built the complete web architecture of agrifunding.org, an agricultural crowdfunding platform connecting investors and farmers (React, Django, Docker, PostgreSQL, AWS). Now leading its development and expansion: building the partner ecosystem across banking, insurance and KYC, securing Astana Hub residency, managing marketing and investor meetings, and preparing the pilot launch with the first farmers.",
    tech: "Product Management • Partnerships • FinTech • React • Django • AWS",
    link: "https://agrifunding.org",
  },
  {
    year: "2025",
    period: "Jul 2025 – Dec 2025",
    title: "INTERACTIVE DESIGN @EVENTAGRATE",
    role: "Ventuz Interactive Designer",
    description:
      "Created 3D models in Blender and motion graphics in Cinema4D. Developed interactive applications and background designs for IDLE using Ventuz.",
    tech: "Ventuz • Blender • Cinema 4D",
    link: "https://www.eventagrate.com/",
  },
  {
    year: "2024",
    period: "Nov 2024 – Jul 2025",
    title: "AI-DRIVEN CULINARY SYSTEMS",
    role: "Application Developer · Business Craft Solutions",
    description:
      "Developed RestroMaster and MyCulinaryExplorer with an AI analysis system. Handled full-cycle production from UI/UX design in Figma to AppStore deployment.",
    tech: "FlutterFlow • Supabase • AI Analysis",
    link: "https://apps.apple.com/kz/app/myculinaryexplorer/id6746160146",
  },
  {
    year: "2024",
    period: "2024",
    title: "DIPLOMA PROJECT",
    role: "Project Manager & Front-end Developer",
    description:
      "Handled front-end development of kyim.kz e-commerce website. Research and deployment.",
    tech: "React • Django Framework • PostgreSQL",
    link: "https://kyim.up.railway.app/",
  },
  {
    year: "2022",
    period: "Sep 2022 – May 2023",
    title: "AI FACE & VOICE RESEARCH",
    role: "Machine Learning Researcher · SDU University",
    description:
      "International collaboration with SDU. Developed biometric identification models using TensorFlow, successfully defended at HOF University, Germany.",
    tech: "TensorFlow • Python • ML Research",
    link: "https://www.hof-university.de",
  },
];
---

<html lang="en">
  <head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta charset="utf-8" />
    <title>Projects | {name}</title>
    <link rel="icon" type="image/svg+xml" href="/G.svg" />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;700&family=Playfair+Display:ital,wght@1,700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <nav class="top-nav">
      <a href="/" class="exit-link">← HOME</a>
      <div class="links">
        <a href={portfolioLink} target="_blank" class="drive-cta">Portfolio ↗</a
        >
        <a href={resumeLink} target="_blank" class="drive-cta">CV ↗</a>
      </div>
    </nav>

    <main class="timeline-container">
      <header class="hero-header">
        <span class="mode-tag">TIME MODE</span>
        <h1>Project Odyssey</h1>
      </header>
      <div class="vertical-track">
        <div class="main-line"></div>
        {
          projects.map((p, index) => (
            <section class="project-slice">
              <div class="year-marker">
                <div class="node" />
                <span class="year-number">{p.year}</span>
              </div>

              <div class="project-info">
                <span class="role-label">{p.role}</span>
                <span class="period">{p.period}</span>
                <h2>{p.title}</h2>
                <p class="desc">{p.description}</p>
                <p class="stack">{p.tech}</p>
                <a href={p.link} target="_blank" class="view-btn">
                  EXPLORE ↗
                </a>
              </div>
            </section>
          ))
        }
      </div>
    </main>

    <style>
      :root {
        --accent-pink: #fbcfe8;
        --deep-pink: #db2777;
      }
      .footer-line {
        width: 1px;
        height: 80px;
        background: var(--accent-pink);
        margin: 0 auto 40px;
        opacity: 0.3;
      }

      body {
        margin: 0;
        font-family: "Montserrat", sans-serif;
        background-color: #1a1a1a;
        color: white;
        overflow-x: hidden;
      }

      .top-nav {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        padding: 30px 60px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        z-index: 100;
        background: linear-gradient(to bottom, rgba(0, 0, 0, 0.9), transparent);
        box-sizing: border-box;
        pointer-events: none;
      }

      .exit-link,
      .links {
        pointer-events: auto;
      }
      .top-nav a {
        color: var(--accent-pink);
        text-decoration: none;
        font-weight: 700;
        font-size: 0.8rem;
        letter-spacing: 2px;
      }

      .links {
        display: flex;
        flex-direction: row;
        gap: 15px;
      }
      .drive-cta {
        border: 1px solid var(--accent-pink);
        padding: 8px 20px;
        border-radius: 5px;
        transition: 0.3s;
      }
      .drive-cta:hover {
        background: var(--accent-pink);
        color: #1a1a1a;
      }

      .timeline-container {
        padding-top: 150px;
      }
      .hero-header {
        text-align: center;
      }
      .mode-tag {
        color: var(--accent-pink);
        letter-spacing: 5px;
        font-size: 0.7rem;
        font-weight: 700;
      }
      h1 {
        font-family: "Playfair Display", serif;
        font-size: 5vw;
        font-style: italic;
        margin-top: 20px;
      }

      .vertical-track {
        position: relative;
        max-width: 1400px;
        margin: 0 auto;
      }

      .main-line {
        position: absolute;
        left: 50%;
        top: 0;
        bottom: 0;
        width: 1px;
        background: rgba(251, 207, 232, 0.3);
        z-index: 1;
      }

      .project-slice {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 90vh;
        position: relative;
        z-index: 2;
      }

      .year-marker {
        position: absolute;
        left: 50%;
        top: 50%;
        transform: translate(-50%, -50%); /* Centers perfectly behind node */
        display: flex;
        flex-direction: column;
        align-items: center;
        pointer-events: none;
      }

      .year-number {
        font-size: 10rem;
        font-family: "Playfair Display", serif;
        font-weight: 700;
        opacity: 0.15;
        color: var(--accent-pink);
        line-height: 1;
      }

      .node {
        width: 14px;
        height: 14px;
        background: white;
        border-radius: 50%;
        box-shadow: 0 0 25px var(--accent-pink);
        position: relative;
        z-index: 10;
      }

      .project-info {
        width: 38%;
        margin-left: 55%;
        text-align: left;
      }

      .project-slice:nth-child(even) .project-info {
        margin-left: 0;
        margin-right: 55%;
        text-align: right;
      }

      .role-label {
        color: var(--accent-pink);
        font-size: 0.7rem;
        letter-spacing: 3px;
        font-weight: 700;
        text-transform: uppercase;
      }
      .period {
        display: block;
        margin-top: 8px;
        font-size: 0.75rem;
        letter-spacing: 2px;
        color: #888;
        text-transform: uppercase;
      }
      h2 {
        font-size: 2.8rem;
        margin: 15px 0;
        line-height: 1.1;
        font-family: "Montserrat", sans-serif;
        font-weight: 700;
      }
      .desc {
        color: #bdbdbd;
        line-height: 1.8;
        font-size: 1.05rem;
        margin-bottom: 25px;
      }
      .stack {
        font-size: 0.85rem;
        color: var(--accent-pink);
        font-weight: 700;
        letter-spacing: 1px;
      }

      .view-btn {
        display: inline-block;
        margin-top: 30px;
        color: white;
        text-decoration: none;
        font-weight: 700;
        border-bottom: 2px solid var(--accent-pink);
        padding-bottom: 5px;
        transition: 0.3s;
      }
      .view-btn:hover {
        letter-spacing: 2px;
        color: var(--accent-pink);
      }

      /* Tablet Adjustments */
      @media (max-width: 1024px) {
        .main-line {
          left: 40px;
        }
        .year-marker {
          left: 13px;
          transform: translateY(-50%);
          display: flex;
          flex-direction: row;
        }
        .year-number {
          font-size: 10rem;
        }
        .project-info,
        .project-slice:nth-child(even) .project-info {
          width: 75%;
          margin-left: 100px;
          margin-right: 0;
          text-align: left;
        }
      }

      /* Phone Specific Fixes (The "Smallness" Fix) */
      @media (max-width: 768px) {
        .top-nav {
          padding: 20px;
        }

        .top-nav a {
          font-size: 0.65rem;
        }
        .drive-cta {
          padding: 6px 12px;
        }

        .timeline-container {
          padding-top: 100px;
        }

        h1 {
          font-size: 2.5rem;
        }

        .main-line {
          left: 20px;
        }
        .year-marker {
          left: 13px;
        }
        .year-number {
          font-size: 10rem;
          opacity: 0.1;
        }

        .project-info,
        .project-slice:nth-child(even) .project-info {
          width: 80%;
          margin-left: 50px;
          margin-right: 0;
          text-align: left;
        }

        h2 {
          font-size: 1.8rem;
        }
        .desc {
          font-size: 0.95rem;
          line-height: 1.6;
        }
        .role-label {
          font-size: 0.6rem;
        }

        .project-slice {
          min-height: auto;
          padding: 60px 0;
        }
      }
    </style>
  </body>
</html>
